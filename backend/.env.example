# ===============================================
# CostPlusDB Backend - Environment Configuration
# ===============================================
#
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
#
# For production: use dotenv-vault to encrypt secrets
# See: 000-docs/057-OD-DEPL-production-deployment-checklist.md
#

# ===============================================
# Database Configuration
# ===============================================

# Local SQLite database path (relative to backend directory)
# For development: use local SQLite
# For production: consider PostgreSQL or Turso
DATABASE_URL="file:../002-clients/database/costplusdb.db"

# Turso Cloud Database (Optional - for production sync)
# Sign up: https://turso.tech
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ===============================================
# Email Configuration (Resend)
# ===============================================
# Sign up: https://resend.com

RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_ADMIN_EMAIL="admin@yourdomain.com"

# ===============================================
# Stripe Configuration
# ===============================================
# Get keys from: https://dashboard.stripe.com/apikeys

# Test mode keys (for development)
STRIPE_SECRET_KEY="sk_test_your_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_test_webhook_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_test_publishable_key"

# Production keys (uncomment for production)
# STRIPE_SECRET_KEY="sk_live_your_live_secret_key"
# STRIPE_WEBHOOK_SECRET="whsec_your_live_webhook_secret"
# STRIPE_PUBLISHABLE_KEY="pk_live_your_live_publishable_key"

# ===============================================
# API Configuration
# ===============================================

# Environment: development, staging, or production
NODE_ENV="development"

# Server port
PORT="3000"

# Base URL for API (used in email links, webhooks, etc.)
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
API_BASE_URL="http://localhost:3000"

# ===============================================
# Security Configuration
# ===============================================

# JWT Secret - MUST be changed for production
# Generate with: openssl rand -base64 64
# CRITICAL: Use a strong, random secret in production (64+ characters)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_STRING"

# Encryption Key - for encrypting sensitive data
# Generate with: openssl rand -hex 32
# CRITICAL: Use a strong, random key in production (64 hex characters)
ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY"

# ===============================================
# CORS Configuration
# ===============================================

# Allowed origins (comma-separated)
# Development: include localhost
# Production: only production domains
CORS_ORIGIN="http://localhost:8000,http://localhost:3000"

# Production example:
# CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com"

# ===============================================
# Rate Limiting
# ===============================================

# Time window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS="900000"

# Max requests per IP per window
RATE_LIMIT_MAX_REQUESTS="100"

# ===============================================
# Logging Configuration
# ===============================================

# Log level: error, warn, info, debug
# Development: debug
# Production: info or warn
LOG_LEVEL="debug"

# Log file path (relative to backend directory)
LOG_FILE_PATH="./logs/app.log"

# ===============================================
# Database Connection Pool
# ===============================================
# (For future PostgreSQL migration)

# Minimum pool connections
DB_POOL_MIN="2"

# Maximum pool connections
DB_POOL_MAX="10"

# ===============================================
# Feature Flags
# ===============================================

# Enable/disable features for testing or gradual rollout

# Enable Turso cloud sync (requires TURSO_* vars)
ENABLE_TURSO_SYNC="false"

# Enable email notifications (requires RESEND_* vars)
ENABLE_EMAIL_NOTIFICATIONS="false"

# Enable Stripe webhooks (requires STRIPE_* vars)
ENABLE_STRIPE_WEBHOOKS="false"

# ===============================================
# Production Deployment Notes
# ===============================================
#
# Before deploying to production:
#
# 1. Generate strong secrets:
#    JWT_SECRET: openssl rand -base64 64
#    ENCRYPTION_KEY: openssl rand -hex 32
#
# 2. Set all production API keys:
#    - RESEND_API_KEY
#    - STRIPE_SECRET_KEY
#    - STRIPE_WEBHOOK_SECRET
#    - TURSO_DATABASE_URL & TURSO_AUTH_TOKEN (if using)
#
# 3. Update configuration:
#    - NODE_ENV="production"
#    - LOG_LEVEL="info"
#    - API_BASE_URL to production domain
#    - CORS_ORIGIN to production domains only
#
# 4. Enable features:
#    - ENABLE_EMAIL_NOTIFICATIONS="true"
#    - ENABLE_STRIPE_WEBHOOKS="true"
#
# 5. Encrypt with dotenv-vault:
#    npx dotenv-vault local build
#    npx dotenv-vault push
#
# 6. Delete .env from production server
#    Use .env.vault instead for encrypted secrets
#
# See full checklist: 000-docs/057-OD-DEPL-production-deployment-checklist.md
#
